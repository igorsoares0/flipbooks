# Production environment. Copy to .env.production on the server (or paste into Coolify) and
# fill in. Never commit real secrets.
#
# BUILD-TIME vs RUNTIME: the three NEXT_PUBLIC_* values are compiled into the browser bundle
# by `next build`, so in Coolify they go in as *build arguments* on the app. Everything else
# is read at run time and belongs in the environment of both the app and the worker.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon: the pooled connection string for the app, the direct one for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/flipbook?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/flipbook?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# A fresh secret, not the development one: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://flipbook.co"
# Header with the caller's IP, for rate limits. Only one the proxy in front writes itself:
# "x-forwarded-for" behind Coolify's Traefik (the default), "cf-connecting-ip" behind
# Cloudflare, and then only if the origin accepts nothing but Cloudflare's addresses.
CLIENT_IP_HEADER="x-forwarded-for"

# Build-time. Wrong here means share links and embeds point at the wrong host.
NEXT_PUBLIC_APP_URL="https://flipbook.co"

# Google sign-in. The callback is <app>/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email ───────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY nothing is sent: mail is appended to a file and no one is told.
# The domain in EMAIL_FROM has to be verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Flipbook <hello@flipbook.co>"

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────────
# The bucket stays private; readers get short-lived signed URLs.
# R2 also needs a CORS rule allowing PUT from NEXT_PUBLIC_APP_URL — the browser uploads
# straight to storage, so without it every upload fails while the app looks healthy.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="flipbook"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ─── PDF worker ──────────────────────────────────────────────────────────────
# Jobs are claimed with FOR UPDATE SKIP LOCKED, so more containers is also a valid answer.
WORKER_CONCURRENCY="1"

# ─── Billing (Paddle, production) ────────────────────────────────────────────
# A production Paddle account is reviewed by Paddle, and they read /terms and /privacy.
# The notification destination points at <app>/api/paddle/webhook.
PADDLE_ENV="production"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# Build-time, both of them.
NEXT_PUBLIC_PADDLE_ENV="production"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Production price ids — not the sandbox ones in .env.example.
PADDLE_PRICE_PRO_MONTH=""
PADDLE_PRICE_PRO_YEAR=""

# ─── Analytics ───────────────────────────────────────────────────────────────
# Salt for the daily visitor hash. Defaults to BETTER_AUTH_SECRET; changing it resets
# the unique-visitor counts from that day on.
ANALYTICS_SALT=""
