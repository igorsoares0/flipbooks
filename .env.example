# Copy to .env.local and fill in. Never commit real secrets.

# Postgres. Local: `npm run db:up` (Docker, port 5433). Production: Neon pooled URL.
DATABASE_URL="postgresql://flipbook:flipbook@localhost:5433/flipbook"
# Optional: Neon direct (unpooled) URL, used by Prisma migrations when set.
DIRECT_URL=""

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public origin used for share links, embeds and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in (optional). The "Continue with Google" button only shows when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional in development). Without RESEND_API_KEY, emails are written to
# EMAIL_OUTBOX_DIR/outbox.jsonl and the links are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Flipbook <hello@flipbook.co>"
EMAIL_OUTBOX_DIR=".emails"

# Object storage (S3 API). Local: MinIO from `npm run db:up`. Production: Cloudflare R2
# (endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto", path style "false").
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="flipbook"
S3_ACCESS_KEY_ID="flipbook"
S3_SECRET_ACCESS_KEY="flipbook-secret"
S3_FORCE_PATH_STYLE="true"

# PDF worker (`npm run worker`): how many jobs it processes at once.
WORKER_CONCURRENCY="1"
